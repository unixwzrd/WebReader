{
  "manifest_version": 3,
  "name": "WebReader",
  "version": "0.1.1",
  "description": "Read selected text or the main article through a local TTS bridge.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:11441/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/webreader-16.png",
    "32": "icons/webreader-32.png",
    "48": "icons/webreader-48.png",
    "128": "icons/webreader-128.png"
  },
  "action": {
    "default_title": "Open WebReader",
    "default_icon": {
      "16": "icons/webreader-16.png",
      "32": "icons/webreader-32.png"
    }
  }
}
